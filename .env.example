# Copy to /etc/ytdl-web.env and adjust. Every option can also be passed as a --flag (see `ytdl-web --help`).

# Keep on localhost when nginx is in front (recommended: there is no login).
YTDL_LISTEN=127.0.0.1:9000

# The yt-dlp executable. Use the zipapp release in a directory the service
# user can write, so "Check for update" works. A pip-installed yt-dlp can't
# update itself this way.
# YTDL_YTDLP=/var/lib/ytdl-web/bin/yt-dlp

# Directory with ffmpeg and ffprobe, if they are not on PATH, e.g. the
# unpacked static build from https://johnvansickle.com/ffmpeg/
# YTDL_FFMPEG_LOCATION=/opt/ffmpeg

# deno (or the directory holding it), if it is not on PATH.
# YTDL_DENO=/opt/deno/deno

# Lets yt-dlp fetch its YouTube challenge solver (needs deno). Empty disables.
# YTDL_REMOTE_COMPONENTS=ejs:github

# Writable cache for yt-dlp and deno (YouTube's challenge solver). Without one
# nothing breaks, but challenges are re-solved (and the solver re-downloaded)
# on every lookup that needs them.
# YTDL_CACHE_DIR=/var/cache/ytdl-web

# Where downloads wait until the browser fetches them, and for how long.
# YTDL_WORK_DIR=/var/cache/ytdl-web/downloads
# YTDL_KEEP_MINUTES=60

# YTDL_LOG=info
